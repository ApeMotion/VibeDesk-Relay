# Use the DNS name on the TLS certificate so Mac clients can use TURN/TLS.
RELAY_DOMAIN=relay.example.com
RELAY_PUBLIC_IP=203.0.113.10
# For a multihomed server, choose its local interface address explicitly.
RELAY_LISTEN_IP=
RELAY_MIN_PORT=49160
RELAY_MAX_PORT=49259
RELAY_TOTAL_QUOTA=64
# Bytes per second. coturn applies separate input and output limits.
RELAY_MAX_BPS=4000000
RELAY_CAPACITY=64000000
